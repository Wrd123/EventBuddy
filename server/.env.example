# Copy this file to server/.env and fill in your values.
# server/.env is git-ignored; never commit real secrets.

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
# Leave unset in development to use a temporary in-memory database
# preloaded with demo data.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventbuddy?retryWrites=true&w=majority

# Secret for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset in development means a random secret per run (logins end on restart).
# JWT_SECRET=

# Public demo: seed the demo data on start and offer one-tap demo sign-in.
# On automatically in development without MONGODB_URI. With it on and no
# MONGODB_URI, production also uses an in-memory database (see render.yaml).
# DEMO_MODE=true

# How long a login lasts
# JWT_EXPIRES_IN=7d

# Port for the API
# PORT=4000

# Web app origin(s) allowed to call the API from a browser, comma-separated
# CLIENT_ORIGIN=http://localhost:3000

# Proxies trusted to report the client's IP (for login rate limiting).
# Default "loopback" covers the web app's dev proxy. When hosted behind a
# load balancer, set the number of proxy hops, usually 1. Never "true".
# TRUST_PROXY=1

# Ticketmaster Discovery API key for Discover's local events
# (developer.ticketmaster.com > My Apps > Consumer Key)
# TICKETMASTER_API_KEY=your-consumer-key

# Contact (email or URL) sent to OpenStreetMap's place lookup, per its policy
# NOMINATIM_CONTACT=you@example.com
